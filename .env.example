# Clé de signature des sessions web (générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(48))")
SESSION_SECRET=changeme

# Clé AES-256 pour le chiffrement des credentials (générée automatiquement si absente)
# NODESNAP_MASTER_KEY=

# Mettre à 1 si l'app est derrière un reverse-proxy de confiance (nginx, traefik…)
# TRUSTED_PROXY=1

# Mettre à 1 quand l'app est servie en HTTPS — marque le cookie de session Secure
# HTTPS_ONLY=1

# Vérification des clés d'hôte SSH des équipements (TOFU, fichier ./known_hosts).
# Mettre à 0 pour revenir à l'ancien comportement (aucune vérification — déconseillé).
# NODESNAP_SSH_STRICT_HOST_KEYS=1

# Algorithmes SSH legacy (KEX SHA-1, AES-CBC, 3DES, ssh-dss) pour les vieux équipements.
# Mettre à 0 sur un parc moderne pour réduire la surface d'attaque.
# NODESNAP_SSH_LEGACY_ALGOS=1
